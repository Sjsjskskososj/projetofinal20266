{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/statement/layout,_N_T_/statement/page,_N_T_/statement"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/statement/__PAGE__",
    "/statement",
    "/_index",
    "/_head"
  ]
}